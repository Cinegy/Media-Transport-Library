From ff450ccafaea74421833740d676b71b879533ca0 Mon Sep 17 00:00:00 2001
From: Evgeny Taruntaev <eugene@cinegy.com>
Date: Mon, 11 May 2026 15:13:34 +0200
Subject: [PATCH] Improved CPU map build for Win2022

---
 lib/eal/windows/eal_lcore.c | 107 +++++++++++++-----------------------
 1 file changed, 39 insertions(+), 68 deletions(-)

diff --git a/lib/eal/windows/eal_lcore.c b/lib/eal/windows/eal_lcore.c
index 286fe241eb..4373ed0997 100644
--- a/lib/eal/windows/eal_lcore.c
+++ b/lib/eal/windows/eal_lcore.c
@@ -49,50 +49,19 @@ log_early(const char *format, ...)
 	va_end(va);
 }
 
-static int
-eal_query_group_affinity(void)
+static void
+eal_fill_group_affinity(const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *info)
 {
-	SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *infos = NULL;
 	unsigned int *cpu_count = &cpu_map.cpu_count;
-	DWORD infos_size = 0;
-	int ret = 0;
 	USHORT group_count;
 	KAFFINITY affinity;
 	USHORT group_no;
 	unsigned int i;
 
-	if (!GetLogicalProcessorInformationEx(RelationGroup, NULL,
-			&infos_size)) {
-		DWORD error = GetLastError();
-		if (error != ERROR_INSUFFICIENT_BUFFER) {
-			RTE_LOG(ERR, EAL, "Cannot get group information size, error %lu\n", error);
-			rte_errno = EINVAL;
-			ret = -1;
-			goto cleanup;
-		}
-	}
-
-	infos = malloc(infos_size);
-	if (infos == NULL) {
-		RTE_LOG(ERR, EAL, "Cannot allocate memory for NUMA node information\n");
-		rte_errno = ENOMEM;
-		ret = -1;
-		goto cleanup;
-	}
-
-	if (!GetLogicalProcessorInformationEx(RelationGroup, infos,
-			&infos_size)) {
-		RTE_LOG(ERR, EAL, "Cannot get group information, error %lu\n",
-			GetLastError());
-		rte_errno = EINVAL;
-		ret = -1;
-		goto cleanup;
-	}
-
 	*cpu_count = 0;
-	group_count = infos->Group.ActiveGroupCount;
+	group_count = info->Group.ActiveGroupCount;
 	for (group_no = 0; group_no < group_count; group_no++) {
-		affinity = infos->Group.GroupInfo[group_no].ActiveProcessorMask;
+		affinity = info->Group.GroupInfo[group_no].ActiveProcessorMask;
 		for (i = 0; i < EAL_PROCESSOR_GROUP_SIZE; i++) {
 			if ((affinity & ((KAFFINITY)1 << i)) == 0)
 				continue;
@@ -101,20 +70,16 @@ eal_query_group_affinity(void)
 			(*cpu_count)++;
 		}
 	}
-
-cleanup:
-	free(infos);
-	return ret;
 }
 
 static bool
 eal_create_lcore_map(const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *info)
 {
 	const unsigned int node_id = info->NumaNode.NodeNumber;
-	const GROUP_AFFINITY *cores = &info->NumaNode.GroupMask;
+	const GROUP_AFFINITY *cores = info->NumaNode.GroupMasks;
 	struct lcore_map *lcore;
 	unsigned int socket_id;
-	unsigned int i;
+	unsigned int i, g;
 
 	/*
 	 * NUMA node may be reported multiple times if it includes
@@ -134,17 +99,20 @@ eal_create_lcore_map(const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *info)
 		cpu_map.socket_count++;
 	}
 
-	for (i = 0; i < EAL_PROCESSOR_GROUP_SIZE; i++) {
-		if ((cores->Mask & ((KAFFINITY)1 << i)) == 0)
-			continue;
+	for(g = 0; g < RTE_MAX(1u, info->NumaNode.GroupCount); g++)
+	{
+		for (i = 0; i < EAL_PROCESSOR_GROUP_SIZE; i++) {
+			if ((cores[g].Mask & ((KAFFINITY)1 << i)) == 0)
+				continue;
 
-		if (cpu_map.lcore_count == RTE_DIM(cpu_map.lcores))
-			return true;
+			if (cpu_map.lcore_count == RTE_DIM(cpu_map.lcores))
+				return true;
 
-		lcore = &cpu_map.lcores[cpu_map.lcore_count];
-		lcore->socket_id = socket_id;
-		lcore->core_id = cores->Group * EAL_PROCESSOR_GROUP_SIZE + i;
-		cpu_map.lcore_count++;
+			lcore = &cpu_map.lcores[cpu_map.lcore_count];
+			lcore->socket_id = socket_id;
+			lcore->core_id = cores[g].Group * EAL_PROCESSOR_GROUP_SIZE + i;
+			cpu_map.lcore_count++;
+		}
 	}
 	return false;
 }
@@ -157,13 +125,22 @@ eal_create_cpu_map(void)
 	bool full = false;
 	int ret = 0;
 
+	/*
+	 * Use here RelationAll to avoid checking for support of 
+	 * RelationNumaNodeEx, RelationNumaNode returns incomplete
+	 * information for Windows Server 2022
+	 * 
+	 * Also use RelationGroup obtained here to fill CPU group
+	 * affinity
+	 */
+
 	infos = NULL;
 	infos_size = 0;
 	if (!GetLogicalProcessorInformationEx(
-			RelationNumaNode, NULL, &infos_size)) {
-		DWORD error = GetLastError();
+			RelationAll, NULL, &infos_size)) {
+			DWORD error = GetLastError();
 		if (error != ERROR_INSUFFICIENT_BUFFER) {
-			log_early("Cannot get NUMA node info size, error %lu\n",
+			log_early("Cannot get CPU relation info size, error %lu\n",
 				GetLastError());
 			rte_errno = ENOMEM;
 			ret = -1;
@@ -173,15 +150,15 @@ eal_create_cpu_map(void)
 
 	infos = malloc(infos_size);
 	if (infos == NULL) {
-		log_early("Cannot allocate memory for NUMA node information\n");
+		log_early("Cannot allocate memory for CPU relation information\n");
 		rte_errno = ENOMEM;
 		ret = -1;
 		goto exit;
 	}
 
 	if (!GetLogicalProcessorInformationEx(
-			RelationNumaNode, infos, &infos_size)) {
-		log_early("Cannot get NUMA node information, error %lu\n",
+			RelationAll, infos, &infos_size)) {
+		log_early("Cannot get CPU relation information, error %lu\n",
 			GetLastError());
 		rte_errno = EINVAL;
 		ret = -1;
@@ -190,24 +167,18 @@ eal_create_cpu_map(void)
 
 	info = infos;
 	while ((uint8_t *)info - (uint8_t *)infos < infos_size) {
-		if (eal_create_lcore_map(info)) {
-			full = true;
-			break;
+		if (info->Relationship == RelationNumaNode && !full) {
+			if (eal_create_lcore_map(info)) {
+				full = true;
+			}
+		} else if (info->Relationship == RelationGroup) {
+			eal_fill_group_affinity(info);
 		}
 
 		info = (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX *)(
 			(uint8_t *)info + info->Size);
 	}
 
-	if (eal_query_group_affinity()) {
-		/*
-		 * No need to set rte_errno here.
-		 * It is set by eal_query_group_affinity().
-		 */
-		ret = -1;
-		goto exit;
-	}
-
 exit:
 	if (full) {
 		/* Not a fatal error, but important for troubleshooting. */
-- 
2.47.1.windows.2

