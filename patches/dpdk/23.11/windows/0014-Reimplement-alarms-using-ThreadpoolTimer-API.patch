From 2290c03e51c72efb2469f907efcb7c342739b998 Mon Sep 17 00:00:00 2001
From: Evgeny Taruntaev <eugene@cinegy.com>
Date: Mon, 11 Aug 2025 16:47:29 +0200
Subject: [PATCH 14/15] Reimplement alarms using ThreadpoolTimer API

---
 lib/eal/windows/eal_alarm.c | 153 +++++++++---------------------------
 1 file changed, 35 insertions(+), 118 deletions(-)

diff --git a/lib/eal/windows/eal_alarm.c b/lib/eal/windows/eal_alarm.c
index 811c076e0a..15de878b46 100644
--- a/lib/eal/windows/eal_alarm.c
+++ b/lib/eal/windows/eal_alarm.c
@@ -1,5 +1,6 @@
 /* SPDX-License-Identifier: BSD-3-Clause
  * Copyright (c) 2020 Dmitry Kozlyuk
+ * Copyright (c) 2025 Cinegy GmbH
  */
 
 #include <stdatomic.h>
@@ -22,7 +23,7 @@ struct alarm_entry {
 	LIST_ENTRY(alarm_entry) next;
 	rte_eal_alarm_callback cb_fn;
 	void *cb_arg;
-	HANDLE timer;
+	PTP_TIMER timer;
 	atomic_uint state;
 };
 
@@ -30,20 +31,19 @@ static LIST_HEAD(alarm_list, alarm_entry) alarm_list = LIST_HEAD_INITIALIZER();
 
 static rte_spinlock_t alarm_lock = RTE_SPINLOCK_INITIALIZER;
 
-static int intr_thread_exec_sync(void (*func)(void *arg), void *arg);
-
 static void
 alarm_remove_unsafe(struct alarm_entry *ap)
 {
 	LIST_REMOVE(ap, next);
-	CloseHandle(ap->timer);
+	CloseThreadpoolTimer(ap->timer);
 	free(ap);
 }
 
 static void
-alarm_callback(void *arg, DWORD low __rte_unused, DWORD high __rte_unused)
+alarm_callback(PTP_CALLBACK_INSTANCE instance __rte_unused,
+	PVOID context, PTP_TIMER timer __rte_unused)
 {
-	struct alarm_entry *ap = arg;
+	struct alarm_entry *ap = context;
 	unsigned int state = ALARM_ARMED;
 
 	if (!atomic_compare_exchange_strong(
@@ -57,40 +57,22 @@ alarm_callback(void *arg, DWORD low __rte_unused, DWORD high __rte_unused)
 	rte_spinlock_unlock(&alarm_lock);
 }
 
-static int
-alarm_set(struct alarm_entry *entry, LARGE_INTEGER deadline)
-{
-	BOOL ret = SetWaitableTimer(
-		entry->timer, &deadline, 0, alarm_callback, entry, FALSE);
-	if (!ret) {
-		RTE_LOG_WIN32_ERR("SetWaitableTimer");
-		return -1;
-	}
-	return 0;
-}
-
-struct alarm_task {
-	struct alarm_entry *entry;
-	LARGE_INTEGER deadline;
-	int ret;
-};
-
-static void
-alarm_task_exec(void *arg)
-{
-	struct alarm_task *task = arg;
-	task->ret = alarm_set(task->entry, task->deadline);
-}
-
 int
 rte_eal_alarm_set(uint64_t us, rte_eal_alarm_callback cb_fn, void *cb_arg)
 {
 	struct alarm_entry *ap;
-	HANDLE timer;
+	PTP_TIMER timer;
 	FILETIME ft;
 	LARGE_INTEGER deadline;
 	int ret;
 
+	/* Check parameters, including that us won't cause a uint64_t overflow */
+	if (us < 1 || us > (UINT64_MAX - US_PER_S)) {
+		RTE_LOG(ERR, EAL, "Invalid alarm interval\n");
+		ret = -EINVAL;
+		goto exit;
+	}
+	
 	if (cb_fn == NULL) {
 		RTE_LOG(ERR, EAL, "NULL callback\n");
 		ret = -EINVAL;
@@ -102,6 +84,8 @@ rte_eal_alarm_set(uint64_t us, rte_eal_alarm_callback cb_fn, void *cb_arg)
 	deadline.LowPart = ft.dwLowDateTime;
 	deadline.HighPart = ft.dwHighDateTime;
 	deadline.QuadPart += 10 * us;
+	ft.dwLowDateTime = deadline.LowPart;
+	ft.dwHighDateTime = deadline.HighPart;
 
 	ap = calloc(1, sizeof(*ap));
 	if (ap == NULL) {
@@ -110,9 +94,9 @@ rte_eal_alarm_set(uint64_t us, rte_eal_alarm_callback cb_fn, void *cb_arg)
 		goto exit;
 	}
 
-	timer = CreateWaitableTimer(NULL, FALSE, NULL);
+	timer = CreateThreadpoolTimer(alarm_callback, ap, NULL);
 	if (timer == NULL) {
-		RTE_LOG_WIN32_ERR("CreateWaitableTimer()");
+		RTE_LOG_WIN32_ERR("CreateThreadpoolTimer()");
 		ret = -EINVAL;
 		goto fail;
 	}
@@ -121,46 +105,19 @@ rte_eal_alarm_set(uint64_t us, rte_eal_alarm_callback cb_fn, void *cb_arg)
 	ap->cb_fn = cb_fn;
 	ap->cb_arg = cb_arg;
 
-	/* Waitable timer must be set in the same thread that will
-	 * do an alertable wait for the alarm to trigger, that is,
-	 * in the interrupt thread.
-	 */
-	if (rte_thread_is_intr()) {
-		/* Directly schedule callback execution. */
-		ret = alarm_set(ap, deadline);
-		if (ret < 0) {
-			RTE_LOG(ERR, EAL, "Cannot setup alarm\n");
-			goto fail;
-		}
-	} else {
-		/* Dispatch a task to set alarm into the interrupt thread.
-		 * Execute it synchronously, because it can fail.
-		 */
-		struct alarm_task task = {
-			.entry = ap,
-			.deadline = deadline,
-		};
-
-		ret = intr_thread_exec_sync(alarm_task_exec, &task);
-		if (ret < 0) {
-			RTE_LOG(ERR, EAL, "Cannot setup alarm in interrupt thread\n");
-			goto fail;
-		}
-
-		ret = task.ret;
-		if (ret < 0)
-			goto fail;
-	}
-
+	/* first add record to the alarms list, then schedule the timer */
 	rte_spinlock_lock(&alarm_lock);
 	LIST_INSERT_HEAD(&alarm_list, ap, next);
 	rte_spinlock_unlock(&alarm_lock);
 
+	SetThreadpoolTimer(timer, &ft, 0, 0); /* cannot fail */ 
+	ret = 0;
+
 	goto exit;
 
 fail:
 	if (timer != NULL)
-		CloseHandle(timer);
+		CloseThreadpoolTimer(timer);
 	free(ap);
 
 exit:
@@ -179,7 +136,7 @@ alarm_matches(const struct alarm_entry *ap,
 int
 rte_eal_alarm_cancel(rte_eal_alarm_callback cb_fn, void *cb_arg)
 {
-	struct alarm_entry *ap,*ap_prev,*ap_next;
+	struct alarm_entry *ap;
 	unsigned int state;
 	int removed;
 	bool executing;
@@ -196,70 +153,30 @@ rte_eal_alarm_cancel(rte_eal_alarm_callback cb_fn, void *cb_arg)
 
 		rte_spinlock_lock(&alarm_lock);
 
-    ap = NULL;
-    ap_prev = ap;
 		LIST_FOREACH(ap, &alarm_list, next) {
-			if (!alarm_matches(ap, cb_fn, cb_arg)){
-				ap_prev = ap;
+			if (!alarm_matches(ap, cb_fn, cb_arg))
 				continue;
-			}
 
 			state = ALARM_ARMED;
 			if (atomic_compare_exchange_strong(
 					&ap->state, &state, ALARM_CANCELLED)) {
-				ap_next = LIST_NEXT((ap), next);
+				SetThreadpoolTimer(ap->timer, NULL, 0, 0);
+				WaitForThreadpoolTimerCallbacks(ap->timer, TRUE);
 				alarm_remove_unsafe(ap);
-				if( ap_prev ) ap = ap_prev;
-				else ap = ap_next;
 				removed++;
-				if(ap == NULL) break;
-			} else if (state == ALARM_TRIGGERED){
+			} else if (state == ALARM_TRIGGERED)
 				executing = true;
-				ap_prev = ap;
-			}
 		}
+
 		rte_spinlock_unlock(&alarm_lock);
+
+		/* Yield control to a second thread executing eal_alarm_callback to avoid
+		 * its starvation, as it is waiting for the lock we have just released.
+		 */
+		SwitchToThread();
+		
 	} while (executing);
 
 	rte_eal_trace_alarm_cancel(cb_fn, cb_arg, removed);
 	return removed;
 }
-
-struct intr_task {
-	void (*func)(void *arg);
-	void *arg;
-	rte_spinlock_t lock; /* unlocked at task completion */
-};
-
-static void
-intr_thread_entry(void *arg)
-	__rte_no_thread_safety_analysis
-{
-	struct intr_task *task = arg;
-	task->func(task->arg);
-	rte_spinlock_unlock(&task->lock);
-}
-
-static int
-intr_thread_exec_sync(void (*func)(void *arg), void *arg)
-	__rte_no_thread_safety_analysis
-{
-	struct intr_task task;
-	int ret;
-
-	task.func = func;
-	task.arg = arg;
-	rte_spinlock_init(&task.lock);
-
-	/* Make timers more precise by synchronizing in userspace. */
-	rte_spinlock_lock(&task.lock);
-	ret = eal_intr_thread_schedule(intr_thread_entry, &task);
-	if (ret < 0) {
-		RTE_LOG(ERR, EAL, "Cannot schedule task to interrupt thread\n");
-		return -EINVAL;
-	}
-
-	/* Wait for the task to complete. */
-	rte_spinlock_lock(&task.lock);
-	return 0;
-}
-- 
